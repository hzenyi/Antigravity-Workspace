{
  "mcpServers": {
    "google-calendar": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx.cmd",
        "-y",
        "@cocal/google-calendar-mcp"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "C:\\Users\\user\\.config\\google-calendar-mcp\\gcp-oauth.keys.json"
      }
    }
  }
}

